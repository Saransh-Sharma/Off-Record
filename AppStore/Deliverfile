# Fastlane Deliver Configuration for OffRecord AI Journal
# Run: fastlane deliver from the project root

app_identifier "com.singularity.offrecord"
username "" # Your Apple ID

# App Store Metadata
name({
  "en-US" => "OffRecord AI Journal"
})

subtitle({
  "en-US" => "Private Journal & Mood Tracker"
})

keywords({
  "en-US" => "diary,journal,voice,mood tracker,private AI assistant,private,speech to text,mindfulness,encrypted,anxiety"
})

promotional_text({
  "en-US" => "Now on Mac. Friday runs on Apple's on-device model, plus Month and Year in Review, tags, journals, and imports from Day One and Apple Journal."
})

release_notes({
  "en-US" => "New in v1.5:\n\n- OffRecord on Mac, with Write, Record, and Search in the menu bar and keyboard shortcuts.\n- OffRecord now speaks Spanish: the app, widgets, Apple Watch, and Siri phrases.\n- Friday on Apple's on-device model: with Apple Intelligence, she keeps a conversation going, looks things up in your journal, and cites the entries she used.\n- Entries can get short titles.\n- Month in Review and Year in Review, with a year card you can share.\n- Session Prep: a summary of a date range to bring to a session with a therapist or coach.\n- Tags: add them to entries, filter the Timeline by tag, and search with #.\n- Multiple journals, each with its own entry for the day. Export any journal as a PDF.\n- A page for each person, place, and topic in My World.\n- Import from Day One, Apple Journal, Markdown or text files, and CSV.\n- Siri can add to your journal, search it, and ask Friday. Siri gets a summary only, never quotes.\n- Journaling Suggestions on iPhone.\n- Keep any entry out of Friday, turn Friday off, or erase all data.\n- Streaks allow one rest day in any 7 days, or switch to weekly streaks.\n- iCloud sync status in Settings, and a recovery screen if your journal can't open.\n- Get Support shows your region's crisis line and works offline."
})

privacy_url "https://saransh-sharma.github.io/Off-Record/privacy.html"
support_url "https://saransh-sharma.github.io/Off-Record/support.html"
marketing_url "https://saransh-sharma.github.io/Off-Record/"

copyright "2026 OffRecord AI Journal"

primary_category "LIFESTYLE"
secondary_category "PRODUCTIVITY"

# Pricing
price_tier 0  # Free

# Rating
app_rating_config_path "./AppStore/rating_config.json"

# Auto-release after approval
automatic_release true

# Screenshots path
screenshots_path "./AppStore/screenshots"

# Skip if no metadata changes
skip_metadata false
skip_screenshots false
