# Fastlane Deliver Configuration for OffRecord AI Journal
# Run: fastlane deliver from the project root

app_identifier "com.singularity.offrecord"
username "" # Your Apple ID

# App Store Metadata
name({
  "en-US" => "OffRecord AI Journal"
})

subtitle({
  "en-US" => "Private Journal & Mood Tracker"
})

keywords({
  "en-US" => "diary,journal,voice,mood tracker,private AI assistant,private,speech to text,mindfulness,encrypted,anxiety"
})

promotional_text({
  "en-US" => "NEW: Apple Watch Quick Capture for mood, dictation, and audio notes. Saved on watch first, synced privately to iPhone."
})

release_notes({
  "en-US" => "New in v1.4:\n\n- Apple Watch Quick Capture: Save Mood, Speak, and Record captures from your wrist.\n- Private Outbox: Watch captures save locally first and retry later if your iPhone is unreachable.\n- Watch Complication and Smart Stack: Open Quick Capture with generic, privacy-safe status only.\n- Better Audio Notes: Multiple watch recordings can attach to the same daily entry.\n- Safer Sync: Duplicate watch deliveries are ignored, and audio imports require the file before a receipt is created.\n- Still private: No analytics, no tracking, and no developer servers for watch captures."
})

privacy_url "https://saransh-sharma.github.io/Off-Record/privacy.html"
support_url "https://saransh-sharma.github.io/Off-Record/support.html"
marketing_url "https://saransh-sharma.github.io/Off-Record/"

copyright "2026 OffRecord AI Journal"

primary_category "LIFESTYLE"
secondary_category "PRODUCTIVITY"

# Pricing
price_tier 0  # Free

# Rating
app_rating_config_path "./AppStore/rating_config.json"

# Auto-release after approval
automatic_release true

# Screenshots path
screenshots_path "./AppStore/screenshots"

# Skip if no metadata changes
skip_metadata false
skip_screenshots false
